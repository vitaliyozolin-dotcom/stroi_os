{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy {
    dynamic a app 3000 {
      refresh 5s
      versions ipv4
    }
    lb_try_duration 10s
    lb_try_interval 250ms
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options "DENY"
    Referrer-Policy "same-origin"
    -Server
  }
}

# Routes for externally hosted applications are stored in Caddy's persistent
# data volume so container recreation and ordinary StroiOS deploys retain them.
import /data/external-routes.caddy
